# LLM Provider: "openai" (default) or "ollama"
APP_ENVIRONMENT=development
LLM_PROVIDER=openai

# OpenAI settings (used when LLM_PROVIDER=openai)
# NOTE: In production, store API keys via the admin panel (/admin/login) instead of this env var.
# The env var is only used as a fallback if no keys exist in the database.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codelens
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/codelens

# CORS — comma-separated frontend URLs allowed (e.g. https://app.vercel.app,https://my-domain.com)
# Leave empty for local development defaults
ALLOWED_ORIGINS=

# Admin panel (local development only; production uses ADMIN_PASSWORD_HASH)
ADMIN_PASSWORD=choose-a-local-admin-password
ADMIN_PASSWORD_HASH=
# Stable signing secret is mandatory in production (32+ random characters).
ADMIN_SESSION_SECRET=
# Leave empty locally to generate a persisted key. In production this must be
# one stable Fernet key stored in the hosting provider's secret manager.
ENCRYPTION_KEY=
# Local non-Docker default. Docker Compose overrides this with a persistent volume path.
MASTER_KEY_PATH=./data/master.key

# GitHub (optional — avoids rate limits)
GITHUB_TOKEN=

# Public cost and abuse controls
MAX_CONCURRENT_ANALYSES=2
ANALYSIS_REQUESTS_PER_HOUR=5
CHAT_REQUESTS_PER_MINUTE=30
AI_MAX_OUTPUT_TOKENS=4096
# Emergency owner-controlled kill switch for all AI requests.
AI_FEATURES_ENABLED=true
